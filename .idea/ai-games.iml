      <excludeFolder url="file://$MODULE_DIR$/gymnasium/.idea" />
      <excludeFolder url="file://$MODULE_DIR$/gymnasium/.venv/bin" />
      <excludeFolder url="file://$MODULE_DIR$/gymnasium/.venv/include" />
      <excludeFolder url="file://$MODULE_DIR$/gymnasium/.venv/lib" />
      <excludeFolder url="file://$MODULE_DIR$/gymnasium/PyGame-Learning-Environment/ple.egg-info" />
    </content>
    <orderEntry type="jdk" jdkName="Python 3.12 virtualenv at ~/code/ai-games/.venv" jdkType="Python SDK" />
